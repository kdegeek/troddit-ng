#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

# Match Docker's Node 22 and package.json's Yarn Classic without changing the
# orb's system Node (which Amp and other tools may need).
toolchain="$HOME/.local/share/troddit-toolchain"
SECONDS=0
echo "Preparing Node 22.23.2 and Yarn 1.22.19..."
if [[ ! -x "$toolchain/bin/node" ]] || [[ "$("$toolchain/bin/node" --version)" != v22.23.2 ]] ||
   [[ ! -f "$toolchain/lib/node_modules/yarn/package.json" ]] ||
   [[ "$(node -p "require('$toolchain/lib/node_modules/yarn/package.json').version")" != 1.22.19 ]]; then
  npm install --prefix "$toolchain" --global --no-audit --no-fund node@22.23.2 yarn@1.22.19
fi
export PATH="$toolchain/bin:$PATH"
echo "Toolchain ready in ${SECONDS}s: $(node --version), Yarn $(yarn --version)"

# Amp and supervised services use separate login shells. Scope this PATH to
# this checkout and its descendants, leaving the system toolchain elsewhere.
marker="# Troddit Node 22 toolchain (after orb environment)"
if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<EOF

$marker
case "\$PWD/" in
  "$repo_root/"*)
    case "\$PATH" in
      "$toolchain/bin"|"$toolchain/bin:"*) ;;
      *) export PATH="$toolchain/bin:\$PATH" ;;
    esac
    ;;
esac
EOF
fi

SECONDS=0
echo "Installing locked dependencies (including development tools)..."
yarn install --frozen-lockfile --non-interactive --prefer-offline --production=false
echo "Dependencies ready in ${SECONDS}s"

# Never generate or bake credentials into a snapshot, or overwrite local config.
if [[ ! -f .env.local ]]; then
  cp -- .env.example .env.local
fi
echo "Setup complete. Optional login/integration credentials must be supplied separately."
